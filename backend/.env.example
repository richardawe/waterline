DATABASE_URL=postgresql+psycopg://waterline:waterline@localhost:5432/waterline
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:5500,http://localhost:8000

# Blog pipeline (backend/app/blog/) — see docs/blog-pipeline.md
OPENROUTER_API_KEY=
# Comma-separated fallback chain, tried left to right — free-tier model
# availability on OpenRouter rotates, so don't rely on a single slug.
OPENROUTER_WRITER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
OPENROUTER_QA_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
BLOG_SITE_BASE_URL=https://waterline.ng
BLOG_NEWS_FEED_URLS=https://nairametrics.com/feed/,https://techcabal.com/feed/
BLOG_NEWS_MAX_AGE_DAYS=14
