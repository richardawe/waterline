# Generated by .github/workflows/deploy.yml — do not edit the deployed copy
# directly, it's overwritten on every push. Edit this template instead.

# Password-protect the admin console. admin.html can create deals, upload
# loan tapes, and structure SPVs against the production database — it must
# never be reachable without a password.
<Files "admin.html">
  AuthType Basic
  AuthName "Waterline Admin"
  AuthUserFile __HTPASSWD_ABS_PATH__
  Require valid-user
</Files>

# Belt-and-suspenders: block direct access to the password file itself, in
# case it ever ends up inside a web-servable directory.
<Files ".htpasswd">
  Require all denied
</Files>
